# Copy to .env and fill in only what you need. .env is ignored by git; never
# commit a credential. With nothing filled in, the app runs entirely locally.

# ocr  = local Tesseract pipeline (default, and the only real extractor)
# stub = replay recorded fixture observations; used by tests and the demos
LABEL_EXTRACTOR=ocr

# How many labels may be in the OCR thread pool at once. The server enforces
# this with a semaphore and the batch page reads it so browser and server agree.
# One Tesseract process per label; set it to about the number of cores.
MAX_BATCH_CONCURRENCY=8

MAX_UPLOAD_BYTES=12582912

# Only needed if the tesseract binary is not on PATH. On Windows the default
# install location (C:\Program Files\Tesseract-OCR) is tried automatically.
# TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Abuse limits for a public deployment.
RATE_LIMIT_PER_MINUTE=120
# Set to 1 behind a host's load balancer (Vercel, Render) so each caller is
# limited separately.
TRUST_PROXY_HEADERS=0
MAX_BATCH_LABELS=500

# A vision model re-reads only the fields OCR could not read on a referred
# label. It can clear a referral; it can never reject. "auto" (the default)
# switches it on when a provider credential below is set, OpenRouter first.
SECOND_OPINION=auto
# Set a credit limit on this key at openrouter.ai; that is the hard spending cap.
# OPENROUTER_API_KEY=
# Default model: anthropic/claude-sonnet-5 on OpenRouter.
# SECOND_OPINION_MODEL=
SECOND_OPINION_DAILY_LIMIT=300
# Alternative to OpenRouter:
# ANTHROPIC_API_KEY=

# Referral triage orders a batch's referrals by how likely each is to be a real
# defect. "jev" (the default) asks TypeSafe's Jev through Vercel AI Gateway and
# falls back to a local heuristic without a credential or when the call fails.
TRIAGE=jev
# On Vercel, the deployment's own OIDC token also works.
# AI_GATEWAY_API_KEY=
