# Copy to .env and fill in. Never commit .env.

# vlm  = cloud vision model (default)
# stub = replay recorded fixture observations; no network, no cost
# ocr  = local/air-gapped path (not implemented -- see README)
LABEL_EXTRACTOR=vlm

ANTHROPIC_API_KEY=

# Latency-first default. Benchmarked against claude-sonnet-5 in eval/out/report.md.
VLM_MODEL=claude-haiku-4-5-20251001

# Downscale longest edge before the API call -- the largest latency lever.
MAX_IMAGE_EDGE_PX=1600

# Browser-side fan-out limit for batch review.
MAX_BATCH_CONCURRENCY=10

MAX_UPLOAD_BYTES=12582912
